{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    },
    "web-admin": {
      "root": "apps/web-admin",
      "framework": "nextjs"
    }
  },
  "redirects": [
    {
      "source": "/book/:practiceId",
      "destination": "/book?practiceId=:practiceId",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://ayushman-api.onrender.com/api/$1"
    },
    {
      "source": "/platform",
      "destination": {
        "service": "web-admin"
      }
    },
    {
      "source": "/platform/(.*)",
      "destination": {
        "service": "web-admin"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
